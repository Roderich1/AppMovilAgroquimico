<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET: lo necesitan la activación, la sesión, la sincronización y los
         respaldos remotos (F03, F05 y F08). Es anterior a la voz y la voz no lo usa:
         `lib/voice/` no importa red (guarda en test/voice/). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- EVO-009 / F09: micrófono. Es el único permiso que añade la captura por voz,
         y se pide en contexto, al tocar el micrófono, no al abrir la aplicación.
         El audio no cruza a Dart ni se guarda. El reconocimiento lo hace el
         `SpeechRecognizer` de Android (ADR-002); ese servicio del sistema puede
         usar la red por su cuenta, y la interfaz lo explica en vez de prometer
         que funciona sin conexión. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <application
        android:label="agroquimicos"
        android:name="${applicationName}"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- EVO-009: sin esto `isRecognitionAvailable()` no puede ver los
             servicios de reconocimiento del sistema en Android 11 y posteriores,
             y la pantalla de voz informaria "sin reconocedor" en aparatos que si
             lo tienen. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
