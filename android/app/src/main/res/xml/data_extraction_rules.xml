<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 y posteriores. Las mismas reglas que backup_rules.xml (inventario
  allí y en F08-ADR-003 §3.8) para la copia en la nube y para la transferencia
  entre dispositivos. allowBackup="false" no bastaría: en Android 12+ no
  detiene la transferencia entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <!-- Segunda barrera: los secretos y las copias, también por su nombre. -->
        <exclude domain="sharedpref" path="agrocuentas_secure_session_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:agrocuentas_secure_session_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:agrocuentas_secure_session_v1.xml" />
        <exclude domain="sharedpref" path="AgrocuentasSessionPointer.xml" />
        <exclude domain="sharedpref" path="agrocuentas_owner_credential_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:agrocuentas_owner_credential_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:agrocuentas_owner_credential_v1.xml" />
        <exclude domain="sharedpref" path="agrocuentas_backup_keys_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:agrocuentas_backup_keys_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:agrocuentas_backup_keys_v1.xml" />
        <exclude domain="database" path="previo" />
        <exclude domain="file" path="remote_backups" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <!-- Segunda barrera: los secretos y las copias, también por su nombre. -->
        <exclude domain="sharedpref" path="agrocuentas_secure_session_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:agrocuentas_secure_session_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:agrocuentas_secure_session_v1.xml" />
        <exclude domain="sharedpref" path="AgrocuentasSessionPointer.xml" />
        <exclude domain="sharedpref" path="agrocuentas_owner_credential_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:agrocuentas_owner_credential_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:agrocuentas_owner_credential_v1.xml" />
        <exclude domain="sharedpref" path="agrocuentas_backup_keys_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:agrocuentas_backup_keys_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:agrocuentas_backup_keys_v1.xml" />
        <exclude domain="database" path="previo" />
        <exclude domain="file" path="remote_backups" />
    </device-transfer>
</data-extraction-rules>
