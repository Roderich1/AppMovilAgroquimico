# Plantilla de configuración de firma de release.
#
# 1. Copie este archivo como `android/key.properties`.
# 2. Rellene los cuatro valores con los de su keystore real.
# 3. NUNCA versione `key.properties` ni el archivo .jks: ambos están en .gitignore.
#
# Para generar un keystore nuevo (guárdelo FUERA del repositorio):
#
#   keytool -genkey -v -keystore /ruta/segura/agrocuentas-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias agrocuentas
#
# ADVERTENCIA: si se pierde el keystore, será imposible publicar
# actualizaciones de la aplicación en Google Play. Haga copia de seguridad.

storeFile=<RUTA_ABSOLUTA_AL_KEYSTORE>
storePassword=<REQUIRED>
keyAlias=<REQUIRED>
keyPassword=<REQUIRED>
