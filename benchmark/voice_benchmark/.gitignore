# --- Spike EVOLUTION-3: artefactos binarios generados, nunca versionados ---
# Las librerias nativas las produce `tool/build_whisper_libs.sh` desde el commit
# fijado de whisper.cpp; los modelos los baja `tool/fetch_whisper_models.sh` y se
# verifican por SHA-256. Ambos se regeneran; meterlos en git solo agregaria
# decenas de MB imposibles de revisar.
android/app/src/whisperCommon/jniLibs/
android/app/src/whisperTiny/assets/
android/app/src/whisperBase/assets/
